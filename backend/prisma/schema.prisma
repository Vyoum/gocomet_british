// SQLite by default. To use Postgres: set provider = "postgresql" and
// DATABASE_URL="postgresql://user:pass@localhost:5432/rfq", then run `npx prisma migrate dev`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  bids      Bid[]
}

model Rfq {
  id                    String        @id @default(uuid())
  referenceId           String        @unique
  name                  String
  bidStartTime          DateTime
  bidCloseTime          DateTime // original close time as configured
  currentCloseTime      DateTime // close time after extensions
  forcedCloseTime       DateTime
  pickupDate            DateTime
  triggerWindowMinutes  Int
  extensionMinutes      Int
  triggerType           String // BID_RECEIVED | ANY_RANK_CHANGE | L1_CHANGE
  extensionCount        Int           @default(0)
  createdAt             DateTime      @default(now())
  bids                  Bid[]
  activity              ActivityLog[]

  @@index([currentCloseTime])
}

model Bid {
  id                 String   @id @default(uuid())
  rfqId              String
  supplierId         String
  freightCharges     Float
  originCharges      Float
  destinationCharges Float
  totalPrice         Float
  transitTimeDays    Int
  quoteValidUntil    DateTime
  createdAt          DateTime @default(now())
  rfq                Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier           Supplier @relation(fields: [supplierId], references: [id])

  @@index([rfqId, supplierId, createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  rfqId     String
  type      String // RFQ_CREATED | BID_PLACED | EXTENDED
  message   String
  metadata  String? // JSON string (portable across SQLite/Postgres)
  createdAt DateTime @default(now())
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId, createdAt])
}
