# postgres:// and postgresql:// URLs are accepted (converted to postgresql+psycopg:// in code)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rfq
PORT=4000
# Comma-separated allowed origins (e.g. your Vercel URL). Empty = allow all.
CORS_ORIGIN=
# true = seed demo data on start, only when the DB is empty
SEED_DEMO=false
